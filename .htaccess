<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let /api/* fall through to the mobile API's own router
    RewriteRule ^api(/|$) - [L]

    # Everything else → admin front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>