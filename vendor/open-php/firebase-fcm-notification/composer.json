{
    "name": "open-php/firebase-fcm-notification",
    "description": "A robust PHP library for sending Firebase Cloud Messaging (FCM) notifications using the HTTP v1 API. Features include simple access token management, topic messaging, and support for rich notifications with images.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/mrsandipmandal/firebaseNotification",
    "support": {
        "issues": "https://github.com/mrsandipmandal/firebaseNotification/issues",
        "source": "https://github.com/mrsandipmandal/firebaseNotification"
    },
    "keywords": [
        "firebase",
        "fcm",
        "notification",
        "php",
        "google-api",
        "cloud-messaging",
        "push-notification",
        "android",
        "ios",
        "web",
        "oauth2",
        "guzzle"
    ],
    "authors": [
        {
            "name": "Sandip Mandal",
            "email": "mr_sandip@zohomail.in",
            "role": "Developer",
            "homepage": "https://mrsandipmandal.github.io"
        }
    ],
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.9",
        "firebase/php-jwt": "^6.10 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OpenPhp\\FirebaseFcm\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}